<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Edit Product - DealBaazi</title>

  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f5f6fa;
      color: #222;
    }

    .header {
      background: linear-gradient(
        135deg,
        #ff6a00,
        #ee0979
      );

      color: white;
      padding: 18px 25px;

      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header h1 {
      font-size: 24px;
    }

    .back-btn {
      background: white;
      color: #e64d00;
      text-decoration: none;
      padding: 9px 15px;
      border-radius: 8px;
      font-weight: bold;
    }

    .container {
      max-width: 900px;
      margin: 30px auto;
      padding: 0 15px;
    }

    .card {
      background: white;
      border-radius: 15px;
      padding: 25px;
      box-shadow:
        0 4px 15px rgba(0,0,0,0.08);
    }

    .card h2 {
      margin-bottom: 22px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .field {
      display: flex;
      flex-direction: column;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label {
      font-weight: bold;
      margin-bottom: 7px;
    }

    input,
    textarea,
    select {

      padding: 12px;

      border: 1px solid #ddd;

      border-radius: 8px;

      font-size: 14px;

      width: 100%;
    }

    textarea {
      min-height: 150px;
      resize: vertical;
      line-height: 1.5;
    }

    input:focus,
    textarea:focus,
    select:focus {

      outline: none;

      border-color: #ff5a00;
    }

    input[type="file"] {

      padding: 9px;

      background: #fafafa;

      cursor: pointer;
    }

    .image-box {

      border: 2px dashed #ddd;

      border-radius: 10px;

      padding: 15px;

      background: #fafafa;
    }

    .gallery {

      display: grid;

      grid-template-columns:
        repeat(5, 1fr);

      gap: 10px;

      margin-bottom: 15px;
    }

    .gallery-item {

      position: relative;

      border: 1px solid #ddd;

      border-radius: 10px;

      overflow: hidden;

      background: white;

      aspect-ratio: 1;
    }

    .gallery-item img {

      width: 100%;
      height: 100%;

      object-fit: contain;
    }

    .new-gallery {

      display: grid;

      grid-template-columns:
        repeat(5, 1fr);

      gap: 10px;

      margin-top: 15px;
    }

    .new-gallery img {

      width: 100%;
      aspect-ratio: 1;

      object-fit: contain;

      border: 1px solid #ddd;

      border-radius: 10px;

      background: white;
    }

    .help {

      color: #777;

      font-size: 12px;

      margin-top: 8px;

      line-height: 1.5;
    }

    .checks {

      display: flex;

      gap: 20px;

      flex-wrap: wrap;

      margin-top: 20px;
    }

    .checks label {

      display: flex;

      align-items: center;

      gap: 6px;

      font-weight: bold;
    }

    .checks input {

      width: auto;
    }

    .buttons {

      display: flex;

      gap: 10px;

      margin-top: 22px;
    }

    .save-btn,
    .cancel-btn {

      border: none;

      padding: 12px 22px;

      border-radius: 8px;

      font-size: 15px;

      font-weight: bold;

      cursor: pointer;

      text-decoration: none;

      text-align: center;
    }

    .save-btn {

      background: #ff5a00;

      color: white;
    }

    .cancel-btn {

      background: #ddd;

      color: #333;
    }

    .badge {

      display: inline-block;

      background: #fff0e8;

      color: #ff5a00;

      padding: 5px 9px;

      border-radius: 6px;

      font-size: 12px;

      margin-bottom: 10px;

      font-weight: bold;
    }

    @media (max-width: 700px) {

      .header {

        flex-direction: column;

        gap: 12px;

        text-align: center;
      }

      .form-grid {

        grid-template-columns: 1fr;
      }

      .field.full {

        grid-column: auto;
      }

      .card {

        padding: 18px;
      }

      .gallery,
      .new-gallery {

        grid-template-columns:
          repeat(2, 1fr);
      }

      .buttons {

        flex-direction: column;
      }

    }

  </style>

</head>

<body>

  <div class="header">

    <h1>✏️ Edit Product</h1>

    <a
      href="/admin"
      class="back-btn"
    >
      ← Back to Admin
    </a>

  </div>


  <div class="container">

    <div class="card">

      <div class="badge">
        DealBaazi Product Editor
      </div>

      <h2>
        Edit: <%= product.name %>
      </h2>


      <form
        action="/admin/edit/<%= product.id %>"
        method="POST"
        enctype="multipart/form-data"
      >

        <div class="form-grid">


          <!-- PRODUCT NAME -->

          <div class="field full">

            <label>
              Product Name
            </label>

            <input
              type="text"
              name="name"
              value="<%= product.name %>"
              required
            >

          </div>


          <!-- PRICE -->

          <div class="field">

            <label>
              Selling Price
            </label>

            <input
              type="number"
              name="price"
              value="<%= product.price %>"
              min="0"
              step="0.01"
            >

          </div>


          <!-- ORIGINAL PRICE -->

          <div class="field">

            <label>
              Original Price
            </label>

            <input
              type="number"
              name="original_price"
              value="<%= product.original_price || '' %>"
              min="0"
              step="0.01"
              placeholder="₹ Original Price"
            >

          </div>


          <!-- DISCOUNT -->

          <div class="field">

            <label>
              Discount
            </label>

            <input
              type="text"
              name="discount"
              value="<%= product.discount %>"
              placeholder="50% OFF"
            >

          </div>


          <!-- RATING -->

          <div class="field">

            <label>
              Rating
            </label>

            <input
              type="number"
              step="0.1"
              min="0"
              max="5"
              name="rating"
              value="<%= product.rating %>"
            >

          </div>


          <!-- CATEGORY -->

          <div class="field">

            <label>
              Category
            </label>

            <select
              name="category_id"
            >

              <option value="">
                Select Category
              </option>

              <% if (categories && categories.length) { %>

                <% categories.forEach(category => { %>

                  <option
                    value="<%= category.id %>"
                    <%= Number(product.category_id) === Number(category.id) ? "selected" : "" %>
                  >
                    <%= category.name %>
                  </option>

                <% }) %>

              <% } %>

            </select>

          </div>


          <!-- AFFILIATE URL -->

          <div class="field">

            <label>
              Affiliate URL
            </label>

            <input
              type="url"
              name="affiliate_url"
              value="<%= product.affiliate_url %>"
              required
            >

          </div>


          <!-- EXPIRY -->

          <div class="field">

            <label>
              Expiry Date
            </label>

            <input
              type="date"
              name="expiry_date"
              value="<%= product.expiry_date || '' %>"
            >

          </div>


          <!-- DESCRIPTION -->

          <div class="field full">

            <label>
              Product Description
            </label>

            <textarea
              name="description"
              placeholder="Product ke baare mein detail description likho..."
            ><%= product.description || '' %></textarea>

          </div>


          <!-- IMAGES -->

          <div class="field full">

            <label>
              Product Photos
            </label>

            <div class="image-box">

              <div class="help">
                Current Product Photos
              </div>

              <div class="gallery">

                <% if (images && images.length > 0) { %>

<% images.forEach(function(image) { %>

  <div class="gallery-item">

    <img
      src="<%= image.image_url || image.url || image.path || image.filename || image %>"
      alt="Product Image"
    >

  </div>

<% }) %>
                <% } else { %>

                  <div class="help">
                    No product photos available.
                  </div>

                <% } %>

              </div>


              <input
                type="file"
                name="images"
                id="imageInput"
                accept="image/jpeg,image/png,image/webp"
                multiple
              >


              <div class="help">

                Maximum <strong>5 photos</strong> select kar sakte ho.

                Agar new photos select karoge,
                current gallery completely replace ho jayegi.

                JPG, PNG ya WEBP.

                Maximum 5MB per image.

              </div>


              <div
                id="newGallery"
                class="new-gallery"
              ></div>

            </div>

          </div>

        </div>


        <!-- CHECKBOXES -->

        <div class="checks">


          <label>

            <input
              type="checkbox"
              name="featured"
              <%= product.featured ? "checked" : "" %>
            >

            ⭐ Featured / Top Pick

          </label>


          <label>

            <input
              type="checkbox"
              name="trending"
              <%= product.trending ? "checked" : "" %>
            >

            📈 Trending

          </label>


          <label>

            <input
              type="checkbox"
              name="hot_deal"
              <%= product.hot_deal ? "checked" : "" %>
            >

            🔥 Hot Deal

          </label>


          <label>

            <input
              type="checkbox"
              name="visible"
              <%= product.visible ? "checked" : "" %>
            >

            👁️ Show

          </label>

        </div>


        <!-- BUTTONS -->

        <div class="buttons">

          <button
            type="submit"
            class="save-btn"
          >
            💾 Save Changes
          </button>


          <a
            href="/admin"
            class="cancel-btn"
          >
            Cancel
          </a>

        </div>

      </form>

    </div>

  </div>


  <script>

    const imageInput =
      document.getElementById("imageInput");

    const newGallery =
      document.getElementById("newGallery");


    imageInput.addEventListener(
      "change",
      function () {

        newGallery.innerHTML = "";

        const files =
          Array.from(this.files);


        if (files.length > 5) {

          alert(
            "Maximum 5 photos allowed."
          );

          this.value = "";

          return;
        }


        files.forEach(function(file) {

          const reader =
            new FileReader();


          reader.onload = function(e) {

            const img =
              document.createElement("img");

            img.src =
              e.target.result;

            newGallery.appendChild(img);

          };


          reader.readAsDataURL(file);

        });

      }
    );

  </script>

</body>

</html>