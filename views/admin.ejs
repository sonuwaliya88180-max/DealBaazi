<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>DealBaazi Admin</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f6fa;
      color: #222;
    }

    button,
    input,
    textarea,
    select {
      font-family: inherit;
    }

    a {
      text-decoration: none;
    }

    /* =========================
       TOP BAR
    ========================= */

    .topbar {
      background: linear-gradient(
        135deg,
        #ff6a00,
        #ff3d00
      );
      color: #fff;
      padding: 14px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 4px 15px rgba(0,0,0,.12);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .brand img {
      width: 48px;
      height: 48px;
      object-fit: contain;
      background: #fff;
      border-radius: 10px;
      padding: 5px;
    }

    .brand h1 {
      font-size: 20px;
      margin-bottom: 3px;
    }

    .brand p {
      font-size: 12px;
      opacity: .9;
    }

    .top-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .top-actions a {
      color: #fff;
      border: 1px solid rgba(255,255,255,.35);
      padding: 9px 12px;
      border-radius: 8px;
      font-size: 13px;
    }

    .top-actions a:hover {
      background: rgba(255,255,255,.15);
    }

    /* =========================
       CONTAINER
    ========================= */

    .container {
      width: min(1400px, 94%);
      margin: 22px auto 80px;
    }

    /* =========================
       STATS
    ========================= */

    .stats {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 15px;
      margin-bottom: 22px;
    }

    .stat-card {
      background: #fff;
      padding: 18px;
      border-radius: 14px;
      box-shadow: 0 3px 12px rgba(0,0,0,.07);
    }

    .stat-card .number {
      font-size: 28px;
      font-weight: 800;
      color: #ff5a00;
      margin-bottom: 5px;
    }

    .stat-card .label {
      color: #666;
      font-size: 13px;
    }

    /* =========================
       QUICK NAV
    ========================= */

    .quick-nav {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 22px;
    }

    .quick-nav a {
      background: #fff;
      color: #333;
      border: 1px solid #e5e5e5;
      padding: 11px 15px;
      border-radius: 9px;
      font-weight: 700;
      font-size: 13px;
    }

    .quick-nav a:hover {
      border-color: #ff5a00;
      color: #ff5a00;
    }

    /* =========================
       SECTION
    ========================= */

    .section {
      background: #fff;
      border-radius: 15px;
      padding: 22px;
      margin-bottom: 22px;
      box-shadow: 0 3px 14px rgba(0,0,0,.06);
    }

    .section-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
      padding-bottom: 12px;
      border-bottom: 1px solid #eee;
    }

    .section-title h2 {
      font-size: 19px;
    }

    .section-title p {
      color: #777;
      font-size: 12px;
      margin-top: 4px;
    }

    /* =========================
       FORMS
    ========================= */

    .form-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 15px;
    }

    .form-group {
      margin-bottom: 3px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 7px;
      color: #333;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid #ddd;
      border-radius: 9px;
      padding: 11px 12px;
      font-size: 14px;
      outline: none;
      background: #fff;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #ff6500;
      box-shadow:
        0 0 0 3px rgba(255,101,0,.08);
    }

    textarea {
      resize: vertical;
      min-height: 95px;
    }

    .checkbox-row {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      align-items: center;
      margin-top: 8px;
    }

    .checkbox {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 13px;
      font-weight: 600;
    }

    .checkbox input {
      width: auto;
    }

    /* =========================
       BUTTONS
    ========================= */

    .btn {
      border: none;
      border-radius: 9px;
      padding: 11px 16px;
      cursor: pointer;
      font-weight: 700;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .btn-primary {
      background: #ff5a00;
      color: #fff;
    }

    .btn-primary:hover {
      background: #e94f00;
    }

    .btn-secondary {
      background: #f1f1f1;
      color: #333;
    }

    .btn-danger {
      background: #dc3545;
      color: #fff;
    }

    .btn-success {
      background: #198754;
      color: #fff;
    }

    .btn-small {
      padding: 8px 10px;
      font-size: 12px;
    }

    /* =========================
       HOMEPAGE EDITOR
    ========================= */

    .editor-intro {
      background: linear-gradient(
        135deg,
        #fff4ec,
        #fff
      );
      border: 1px solid #ffe0cc;
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 18px;
    }

    .editor-intro strong {
      color: #f05a00;
    }

    .image-preview {
      margin-top: 8px;
      width: 110px;
      height: 70px;
      object-fit: contain;
      border: 1px solid #eee;
      border-radius: 8px;
      background: #fafafa;
      padding: 5px;
    }

    .feature-editor {
      border: 1px solid #eee;
      border-radius: 12px;
      padding: 15px;
      margin-top: 15px;
      background: #fafafa;
    }

    .feature-editor h3 {
      font-size: 15px;
      margin-bottom: 13px;
    }

    .section-toggle {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-top: 15px;
    }

    .toggle-box {
      border: 1px solid #eee;
      border-radius: 10px;
      padding: 12px;
      background: #fafafa;
    }

    .toggle-box label {
      margin: 0;
    }

    /* =========================
       BANNERS
    ========================= */

    .banner-form {
      border: 1px solid #eee;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 18px;
      background: #fafafa;
    }

    .banner-list {
      display: grid;
      gap: 15px;
    }

    .banner-card {
      border: 1px solid #eee;
      border-radius: 12px;
      overflow: hidden;
      display: grid;
      grid-template-columns: 220px 1fr;
      background: #fff;
    }

    .banner-image {
      min-height: 150px;
      background: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .banner-image img {
      width: 100%;
      height: 100%;
      max-height: 220px;
      object-fit: cover;
    }

    .banner-content {
      padding: 16px;
    }

    .banner-content h3 {
      margin-bottom: 7px;
    }

    .banner-content p {
      color: #666;
      font-size: 13px;
      margin-bottom: 7px;
    }

    .banner-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 12px;
    }

    .status {
      display: inline-block;
      padding: 5px 8px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      margin-bottom: 9px;
    }

    .status.active {
      background: #e8f8ee;
      color: #168044;
    }

    .status.inactive {
      background: #fcebec;
      color: #b4232d;
    }

    /* =========================
       PRODUCT TABLE
    ========================= */

    .table-tools {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 15px;
    }

    .table-tools input {
      max-width: 300px;
    }

    .table-tools select {
      max-width: 200px;
    }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid #eee;
      border-radius: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 850px;
    }

    th,
    td {
      padding: 12px 10px;
      border-bottom: 1px solid #eee;
      text-align: left;
      font-size: 13px;
      vertical-align: middle;
    }

    th {
      background: #fafafa;
      font-size: 12px;
      color: #555;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .product-thumb {
      width: 55px;
      height: 55px;
      object-fit: contain;
      border: 1px solid #eee;
      border-radius: 8px;
      background: #fff;
      padding: 3px;
    }

    .product-name {
      font-weight: 700;
      max-width: 220px;
    }

    .price {
      font-weight: 800;
      color: #111;
    }

    .old-price {
      color: #999;
      text-decoration: line-through;
      font-size: 11px;
      margin-left: 4px;
    }

    .actions {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
    }

    /* =========================
       CATEGORY / REVIEW CARDS
    ========================= */

    .category-grid {
      display: grid;
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .category-card {
      border: 1px solid #eee;
      border-radius: 10px;
      padding: 13px;
      background: #fff;
    }

    .category-card strong {
      display: block;
      margin-bottom: 7px;
    }

    .category-card small {
      color: #777;
    }

    .review-card {
      border: 1px solid #eee;
      border-radius: 10px;
      padding: 14px;
      margin-bottom: 10px;
    }

    .review-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    .stars {
      color: #ff9d00;
      font-weight: 700;
    }

    .review-comment {
      color: #555;
      font-size: 13px;
      margin: 8px 0;
    }

    /* =========================
       MODAL
    ========================= */

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.55);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 15px;
    }

    .modal.show {
      display: flex;
    }

    .modal-box {
      background: #fff;
      width: min(520px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      border-radius: 15px;
      padding: 20px;
    }

    .modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }

    .close {
      border: none;
      background: #eee;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 18px;
    }

    /* =========================
       MOBILE BOTTOM NAV
    ========================= */

    .mobile-nav {
      display: none;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 900px) {

      .stats {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .section-toggle {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .category-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .banner-card {
        grid-template-columns: 1fr;
      }

      .banner-image {
        min-height: 180px;
      }
    }

    @media (max-width: 650px) {

      body {
        padding-bottom: 70px;
      }

      .topbar {
        padding: 10px 12px;
      }

      .brand img {
        width: 42px;
        height: 42px;
      }

      .brand h1 {
        font-size: 17px;
      }

      .brand p {
        font-size: 10px;
      }

      .top-actions {
        display: none;
      }

      .container {
        width: 94%;
        margin-top: 15px;
      }

      .stats {
        gap: 9px;
      }

      .stat-card {
        padding: 13px;
      }

      .stat-card .number {
        font-size: 23px;
      }

      .section {
        padding: 15px;
        border-radius: 12px;
      }

      .section-title h2 {
        font-size: 17px;
      }

      .form-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .form-group.full {
        grid-column: auto;
      }

      .section-toggle {
        grid-template-columns: 1fr 1fr;
      }

      .category-grid {
        grid-template-columns: 1fr;
      }

      .quick-nav {
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 4px;
      }

      .quick-nav a {
        white-space: nowrap;
      }

      .mobile-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 62px;
        background: #fff;
        border-top: 1px solid #ddd;
        display: grid;
        grid-template-columns:
          repeat(5, 1fr);
        z-index: 1500;
        box-shadow: 0 -3px 15px rgba(0,0,0,.08);
      }

      .mobile-nav a {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #555;
        font-size: 10px;
        gap: 3px;
      }

      .mobile-nav a span {
        font-size: 20px;
      }

      input,
      textarea,
      select {
        font-size: 16px;
      }
    }
  </style>
</head>

<body>

<!-- ======================================================
     TOPBAR
====================================================== -->

<header class="topbar">

  <div class="brand">

    <img
      src="<%= siteSettings && siteSettings.logo_url ? siteSettings.logo_url : '/images/logo.png' %>"
      alt="DealBaazi"
    >

    <div>
      <h1>DealBaazi Admin</h1>
      <p>Manage your deals & products</p>
    </div>

  </div>

  <div class="top-actions">

    <a
      href="/"
      target="_blank"
    >
      🌐 Website
    </a>

    <a href="/password">
      🔐 Password
    </a>

    <a href="/logout">
      🚪 Logout
    </a>

  </div>

</header>


<div class="container">

<!-- ======================================================
     STATS
====================================================== -->

<section class="stats">

  <div class="stat-card">
    <div class="number">
      <%= stats.totalProducts %>
    </div>

    <div class="label">
      Total Products
    </div>
  </div>


  <div class="stat-card">
    <div class="number">
      <%= stats.liveProducts %>
    </div>

    <div class="label">
      Live Products
    </div>
  </div>


  <div class="stat-card">
    <div class="number">
      <%= stats.categories %>
    </div>

    <div class="label">
      Categories
    </div>
  </div>


  <div class="stat-card">
    <div class="number">
      <%= stats.reviews %>
    </div>

    <div class="label">
      Reviews
    </div>
  </div>

</section>


<!-- ======================================================
     QUICK NAV
====================================================== -->

<nav class="quick-nav">

  <a href="#homepage">
    🏠 Homepage
  </a>

  <a href="#add-product">
    ➕ Add Product
  </a>

  <a href="#categories">
    📂 Categories
  </a>

  <a href="#products">
    🛍️ Products
  </a>

  <a href="#reviews">
    ⭐ Reviews
  </a>

</nav>


<!-- ======================================================
     HOMEPAGE EDITOR
====================================================== -->

<section
  class="section"
  id="homepage"
>

  <div class="section-title">

    <div>
      <h2>🏠 Homepage Editor</h2>

      <p>
        Logo, hero text, features aur homepage sections yahin se change karo.
      </p>
    </div>

  </div>


  <div class="editor-intro">

    <strong>💡 Easy Editing:</strong>

    Yahan changes karne ke baad
    <strong>Save Homepage</strong>
    dabao. Website par changes immediately show honge.
    Code edit karne ki zarurat nahi.
  </div>


  <form
    action="/admin/homepage/save"
    method="POST"
    enctype="multipart/form-data"
  >

    <div class="form-grid">

      <!-- LOGO -->

      <div class="form-group">

        <label>
          Website Logo
        </label>

        <input
          type="file"
          name="logo"
          accept="image/jpeg,image/png,image/webp"
        >

        <% if (siteSettings && siteSettings.logo_url) { %>

          <img
            class="image-preview"
            src="<%= siteSettings.logo_url %>"
            alt="Logo"
          >

        <% } %>

      </div>


      <!-- HERO IMAGE -->

      <div class="form-group">

        <label>
          Hero Banner Image
        </label>

        <input
          type="file"
          name="hero_image"
          accept="image/jpeg,image/png,image/webp"
        >

        <% if (siteSettings && siteSettings.hero_image) { %>

          <img
            class="image-preview"
            src="<%= siteSettings.hero_image %>"
            alt="Hero"
          >

        <% } %>

      </div>


      <!-- HERO TITLE -->

      <div class="form-group full">

        <label>
          Hero Main Heading
        </label>

        <input
          type="text"
          name="hero_title"
          value="<%= siteSettings.hero_title || '' %>"
          placeholder="Best Deals. Best Prices. DealBaazi."
        >

      </div>


      <!-- HERO DESCRIPTION -->

      <div class="form-group full">

        <label>
          Hero Description
        </label>

        <textarea
          name="hero_description"
          placeholder="Enter homepage description"
        ><%= siteSettings.hero_description || '' %></textarea>

      </div>


      <!-- HERO BUTTON -->

      <div class="form-group">

        <label>
          Hero Button Text
        </label>

        <input
          type="text"
          name="hero_button_text"
          value="<%= siteSettings.hero_button_text || '' %>"
          placeholder="Explore Deals"
        >

      </div>


      <div class="form-group">

        <label>
          Hero Button Link
        </label>

        <input
          type="text"
          name="hero_button_link"
          value="<%= siteSettings.hero_button_link || '' %>"
          placeholder="#deals"
        >

      </div>

    </div>


    <!-- FEATURE 1 -->

    <div class="feature-editor">

      <h3>
        Feature 1
      </h3>

      <div class="form-grid">

        <div class="form-group">

          <label>
            Icon
          </label>

          <input
            type="text"
            name="feature1_icon"
            value="<%= siteSettings.feature1_icon || '🔥' %>"
          >

        </div>

        <div class="form-group">

          <label>
            Title
          </label>

          <input
            type="text"
            name="feature1_title"
            value="<%= siteSettings.feature1_title || '' %>"
          >

        </div>

        <div class="form-group full">

          <label>
            Description
          </label>

          <input
            type="text"
            name="feature1_description"
            value="<%= siteSettings.feature1_description || '' %>"
          >

        </div>

        <label class="checkbox">

          <input
            type="checkbox"
            name="feature1_enabled"
            <%= siteSettings.feature1_enabled !== '0' ? 'checked' : '' %>
          >

          Show Feature 1

        </label>

      </div>

    </div>


    <!-- FEATURE 2 -->

    <div class="feature-editor">

      <h3>
        Feature 2
      </h3>

      <div class="form-grid">

        <div class="form-group">

          <label>
            Icon
          </label>

          <input
            type="text"
            name="feature2_icon"
            value="<%= siteSettings.feature2_icon || '💰' %>"
          >

        </div>

        <div class="form-group">

          <label>
            Title
          </label>

          <input
            type="text"
            name="feature2_title"
            value="<%= siteSettings.feature2_title || '' %>"
          >

        </div>

        <div class="form-group full">

          <label>
            Description
          </label>

          <input
            type="text"
            name="feature2_description"
            value="<%= siteSettings.feature2_description || '' %>"
          >

        </div>

        <label class="checkbox">

          <input
            type="checkbox"
            name="feature2_enabled"
            <%= siteSettings.feature2_enabled !== '0' ? 'checked' : '' %>
          >

          Show Feature 2

        </label>

      </div>

    </div>


    <!-- FEATURE 3 -->

    <div class="feature-editor">

      <h3>
        Feature 3
      </h3>

      <div class="form-grid">

        <div class="form-group">

          <label>
            Icon
          </label>

          <input
            type="text"
            name="feature3_icon"
            value="<%= siteSettings.feature3_icon || '⭐' %>"
          >

        </div>

        <div class="form-group">

          <label>
            Title
          </label>

          <input
            type="text"
            name="feature3_title"
            value="<%= siteSettings.feature3_title || '' %>"
          >

        </div>

        <div class="form-group full">

          <label>
            Description
          </label>

          <input
            type="text"
            name="feature3_description"
            value="<%= siteSettings.feature3_description || '' %>"
          >

        </div>

        <label class="checkbox">

          <input
            type="checkbox"
            name="feature3_enabled"
            <%= siteSettings.feature3_enabled !== '0' ? 'checked' : '' %>
          >

          Show Feature 3

        </label>

      </div>

    </div>


    <!-- FEATURE 4 -->

    <div class="feature-editor">

      <h3>
        Feature 4
      </h3>

      <div class="form-grid">

        <div class="form-group">

          <label>
            Icon
          </label>

          <input
            type="text"
            name="feature4_icon"
            value="<%= siteSettings.feature4_icon || '⚡' %>"
          >

        </div>

        <div class="form-group">

          <label>
            Title
          </label>

          <input
            type="text"
            name="feature4_title"
            value="<%= siteSettings.feature4_title || '' %>"
          >

