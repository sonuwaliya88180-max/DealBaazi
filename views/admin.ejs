<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>DealBaazi Admin Panel</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6f9;
      color: #222;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button,
    input,
    textarea,
    select {
      font-family: inherit;
    }

    .topbar {
      background: #111827;
      color: white;
      min-height: 65px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 25px;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 10px rgba(0,0,0,.15);
    }

    .brand {
      font-size: 24px;
      font-weight: 800;
    }

    .brand span {
      color: #ff6b00;
    }

    .top-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .top-btn {
      background: #374151;
      color: white;
      padding: 9px 14px;
      border-radius: 7px;
      font-size: 14px;
    }

    .logout-btn {
      background: #dc2626;
    }

    .layout {
      display: flex;
      min-height: calc(100vh - 65px);
    }

    .sidebar {
      width: 240px;
      background: #1f2937;
      color: white;
      padding: 20px 12px;
      flex-shrink: 0;
    }

    .sidebar h3 {
      font-size: 12px;
      color: #9ca3af;
      text-transform: uppercase;
      margin: 10px 12px;
    }

    .nav-link {
      display: block;
      padding: 12px 14px;
      border-radius: 7px;
      margin-bottom: 5px;
      color: #e5e7eb;
      font-size: 14px;
    }

    .nav-link:hover {
      background: #374151;
    }

    .main {
      flex: 1;
      padding: 25px;
      max-width: 1500px;
    }

    .page-title {
      margin-bottom: 20px;
    }

    .page-title h1 {
      font-size: 28px;
      margin-bottom: 5px;
    }

    .page-title p {
      color: #6b7280;
      font-size: 14px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 25px;
    }

    .stat-card {
      background: white;
      border-radius: 10px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,.07);
      border-left: 4px solid #ff6b00;
    }

    .stat-card h3 {
      font-size: 28px;
      margin-bottom: 5px;
    }

    .stat-card p {
      color: #6b7280;
      font-size: 14px;
    }

    .section {
      background: white;
      border-radius: 10px;
      margin-bottom: 25px;
      box-shadow: 0 2px 8px rgba(0,0,0,.06);
      overflow: hidden;
    }

    .section-header {
      padding: 17px 20px;
      border-bottom: 1px solid #eee;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .section-header h2 {
      font-size: 19px;
    }

    .section-body {
      padding: 20px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 7px;
      color: #374151;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid #d1d5db;
      border-radius: 7px;
      padding: 11px 12px;
      outline: none;
      background: white;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #ff6b00;
      box-shadow: 0 0 0 2px rgba(255,107,0,.1);
    }

    textarea {
      min-height: 100px;
      resize: vertical;
    }

    .checkbox-row {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      margin: 10px 0 15px;
    }

    .checkbox {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 14px;
    }

    .checkbox input {
      width: auto;
    }

    .btn {
      border: none;
      border-radius: 7px;
      padding: 10px 15px;
      cursor: pointer;
      font-weight: 700;
      font-size: 14px;
      display: inline-block;
    }

    .btn-primary {
      background: #ff6b00;
      color: white;
    }

    .btn-primary:hover {
      background: #e85d00;
    }

    .btn-green {
      background: #16a34a;
      color: white;
    }

    .btn-blue {
      background: #2563eb;
      color: white;
    }

    .btn-red {
      background: #dc2626;
      color: white;
    }

    .btn-gray {
      background: #6b7280;
      color: white;
    }

    .btn-small {
      padding: 7px 10px;
      font-size: 12px;
    }

    .fetch-row {
      display: flex;
      gap: 10px;
    }

    .fetch-row input {
      flex: 1;
    }

    .fetch-status {
      margin-top: 10px;
      font-size: 13px;
      display: none;
      padding: 10px;
      border-radius: 6px;
    }

    .fetch-status.show {
      display: block;
    }

    .fetch-success {
      background: #dcfce7;
      color: #166534;
    }

    .fetch-error {
      background: #fee2e2;
      color: #991b1b;
    }

    .fetch-warning {
      background: #fef3c7;
      color: #92400e;
    }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 800px;
    }

    th,
    td {
      text-align: left;
      padding: 12px;
      border-bottom: 1px solid #eee;
      font-size: 13px;
      vertical-align: middle;
    }

    th {
      background: #f9fafb;
      font-weight: 700;
    }

    .product-img {
      width: 55px;
      height: 55px;
      object-fit: contain;
      background: #f8f8f8;
      border-radius: 6px;
      padding: 4px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }

    .badge {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }

    .badge-green {
      background: #dcfce7;
      color: #166534;
    }

    .badge-red {
      background: #fee2e2;
      color: #991b1b;
    }

    .badge-orange {
      background: #ffedd5;
      color: #9a3412;
    }

    .badge-blue {
      background: #dbeafe;
      color: #1e40af;
    }

    .banner-preview {
      width: 100%;
      max-width: 220px;
      height: 90px;
      object-fit: cover;
      border-radius: 7px;
      background: #eee;
    }

    .logo-preview {
      max-width: 180px;
      max-height: 70px;
      object-fit: contain;
      margin-top: 5px;
    }

    .danger-box {
      border: 1px solid #fecaca;
      background: #fef2f2;
      border-radius: 8px;
      padding: 15px;
    }

    .empty {
      text-align: center;
      padding: 30px;
      color: #777;
    }

    .rating {
      color: #f59e0b;
      font-weight: bold;
    }

    .review-card {
      border-bottom: 1px solid #eee;
      padding: 15px 0;
    }

    .review-card:last-child {
      border-bottom: none;
    }

    .review-top {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 8px;
    }

    .review-text {
      color: #555;
      line-height: 1.5;
      margin-bottom: 10px;
    }

    .help {
      color: #6b7280;
      font-size: 12px;
      margin-top: 5px;
    }

    .switch-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid #eee;
      padding: 12px;
      border-radius: 7px;
      margin-bottom: 8px;
    }

    @media (max-width: 1000px) {
      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .grid-3 {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 750px) {
      .topbar {
        padding: 12px 15px;
      }

      .top-actions .top-btn:first-child {
        display: none;
      }

      .layout {
        display: block;
      }

      .sidebar {
        width: 100%;
        padding: 10px;
        display: flex;
        overflow-x: auto;
        gap: 5px;
      }

      .sidebar h3 {
        display: none;
      }

      .nav-link {
        white-space: nowrap;
        margin: 0;
      }

      .main {
        padding: 15px;
      }

      .grid-2,
      .grid-3,
      .stats {
        grid-template-columns: 1fr;
      }

      .section-body {
        padding: 15px;
      }

      .fetch-row {
        flex-direction: column;
      }

      .page-title h1 {
        font-size: 23px;
      }
    }
  </style>
</head>

<body>

<%
  const safeSettings = siteSettings || {};

  function getSetting(key, fallback = "") {
    if (safeSettings && typeof safeSettings === "object") {
      if (safeSettings[key] !== undefined && safeSettings[key] !== null) {
        return safeSettings[key];
      }
    }
    return fallback;
  }

  const productList = products || [];
  const categoryList = categories || [];
  const reviewList = reviews || [];
  const bannerList = banners || [];
  const statData = stats || {};

  const totalProducts =
    statData.totalProducts ??
    statData.products ??
    productList.length;

  const totalCategories =
    statData.totalCategories ??
    statData.categories ??
    categoryList.length;

  const totalReviews =
    statData.totalReviews ??
    statData.reviews ??
    reviewList.length;

  const totalClicks =
    statData.totalClicks ??
    statData.clicks ??
    productList.reduce((sum, p) => sum + (Number(p.clicks) || 0), 0);

  const logoValue = getSetting("logo", "/images/logo.png");
  const heroValue = getSetting("hero_image", "");
%>

<header class="topbar">

  <div class="brand">
    Deal<span>Baazi</span> Admin
  </div>

  <div class="top-actions">

    <a href="/" target="_blank" class="top-btn">
      🌐 View Website
    </a>

    <a href="/logout" class="top-btn logout-btn">
      🚪 Logout
    </a>

  </div>

</header>


<div class="layout">

  <aside class="sidebar">

    <h3>Dashboard</h3>

    <a href="#dashboard" class="nav-link">
      📊 Dashboard
    </a>

    <a href="#products" class="nav-link">
      🛍️ Products
    </a>

    <a href="#categories" class="nav-link">
      📂 Categories
    </a>

    <a href="#homepage" class="nav-link">
      🏠 Homepage
    </a>

    <a href="#banners" class="nav-link">
      🖼️ Banners
    </a>

    <a href="#reviews" class="nav-link">
      ⭐ Reviews
    </a>

<a href="#social-media" class="nav-link">
  📱 Social Media
</a>

    <a href="/password" class="nav-link">
      🔐 Change Password
    </a>

  </aside>


  <main class="main">

    <div class="page-title" id="dashboard">

      <h1>DealBaazi Dashboard</h1>

      <p>
        Manage your products, deals, homepage, categories and affiliate links.
      </p>

    </div>


    <div class="stats">

      <div class="stat-card">
        <h3><%= totalProducts %></h3>
        <p>Total Products</p>
      </div>

      <div class="stat-card">
        <h3><%= totalCategories %></h3>
        <p>Categories</p>
      </div>

      <div class="stat-card">
        <h3><%= totalReviews %></h3>
        <p>Total Reviews</p>
      </div>

      <div class="stat-card">
        <h3><%= totalClicks %></h3>
        <p>Affiliate Clicks</p>
      </div>

    </div>


    <!-- ADD PRODUCT -->
    <section class="section" id="products">

      <div class="section-header">
        <h2>➕ Add New Product</h2>
      </div>

      <div class="section-body">

        <div class="form-group">

          <label>Affiliate Product URL</label>

          <div class="fetch-row">

            <input
              type="url"
              id="fetchAffiliateUrl"
              placeholder="Paste Amazon / Flipkart / Meesho affiliate link here"
            >

            <button
              type="button"
              class="btn btn-blue"
              onclick="fetchProduct()"
            >
              🔍 Auto Fetch
            </button>

          </div>

          <div class="help">
            Auto Fetch available data from supported product pages.
          </div>

          <div id="fetchStatus" class="fetch-status"></div>

        </div>


        <form
          action="/admin/add"
          method="POST"
          enctype="multipart/form-data"
          id="addProductForm"
        >

          <div class="grid-2">

            <div class="form-group">

              <label>Product Name *</label>

              <input
                type="text"
                name="name"
                id="productName"
                required
                placeholder="Product name"
              >

            </div>


            <div class="form-group">

              <label>Category *</label>

              <select
                name="category_id"
                id="productCategory"
                required
              >

                <option value="">
                  Select Category
                </option>

                <% categoryList.forEach(category => { %>

                  <option value="<%= category.id %>">
                    <%= category.name %>
                  </option>

                <% }) %>

              </select>

            </div>


            <div class="form-group">

              <label>Sale Price *</label>

              <input
                type="number"
                name="price"
                id="productPrice"
                min="0"
                step="0.01"
                required
                placeholder="999"
              >

            </div>


            <div class="form-group">

              <label>Original Price</label>

              <input
                type="number"
                name="original_price"
                id="productOriginalPrice"
                min="0"
                step="0.01"
                placeholder="1499"
              >

            </div>


            <div class="form-group">

              <label>Discount</label>

              <input
                type="text"
                name="discount"
                id="productDiscount"
                placeholder="33% OFF"
              >

            </div>


            <div class="form-group">

              <label>Rating</label>

              <input
                type="number"
                name="rating"
                id="productRating"
                min="0"
                max="5"
                step="0.1"
                placeholder="4.5"
              >

            </div>


            <div class="form-group">

              <label>Affiliate Link *</label>

              <input
                type="url"
                name="affiliate_url"
                id="productAffiliateUrl"
                required
                placeholder="https://..."
              >

            </div>


            <div class="form-group">

              <label>Product Image URL</label>

              <input
                type="url"
                name="image_url"
                id="productImageUrl"
                placeholder="https://..."
              >

            </div>

          </div>


          <div class="form-group">

            <label>Description</label>

            <textarea
              name="description"
              id="productDescription"
              placeholder="Product description..."
            ></textarea>

          </div>


          <div class="form-group">

            <label>Upload Product Images</label>

            <input
              type="file"
              name="images"
              multiple
              accept="image/jpeg,image/png,image/webp"
            >

            <div class="help">
              You can upload up to 5 images.
            </div>

          </div>


          <div class="checkbox-row">

            <label class="checkbox">

              <input
                type="checkbox"
                name="featured"
                value="1"
              >

              Featured

            </label>


            <label class="checkbox">

              <input
                type="checkbox"
                name="trending"
                value="1"
              >

              Trending

            </label>


            <label class="checkbox">

              <input
                type="checkbox"
                name="hot_deal"
                value="1"
              >

              Hot Deal

            </label>


            <label class="checkbox">

              <input
                type="checkbox"
                name="visible"
                value="1"
                checked
              >

              Visible

            </label>

          </div>


          <div class="form-group">

            <label>Expiry Date</label>

            <input
              type="date"
              name="expiry_date"
            >

          </div>


          <button
            type="submit"
            class="btn btn-primary"
          >
            ➕ Add Product
          </button>

        </form>

      </div>

    </section>


    <!-- PRODUCTS LIST -->
    <section class="section">

      <div class="section-header">

        <h2>🛍️ All Products</h2>

        <span class="badge badge-blue">
          <%= productList.length %> Products
        </span>

      </div>


      <div class="table-wrap">

        <% if (productList.length === 0) { %>

          <div class="empty">
            No products found.
          </div>

        <% } else { %>

          <table>

            <thead>

              <tr>

                <th>Image</th>
                <th>Product</th>
                <th>Price</th>
                <th>Discount</th>
                <th>Rating</th>
                <th>Clicks</th>
                <th>Status</th>
                <th>Actions</th>

              </tr>

            </thead>


            <tbody>

              <% productList.forEach(product => { %>

                <tr>

                  <td>

                    <% if (product.image_url) { %>

                      <img
                        src="<%= product.image_url %>"
                        class="product-img"
                        onerror="this.style.display='none'"
                      >

                    <% } else { %>

                      <div class="product-img"></div>

                    <% } %>

                  </td>


                  <td>

                    <strong>
                      <%= product.name %>
                    </strong>

                    <% if (product.category_name) { %>

                      <div class="help">
                        <%= product.category_name %>
                      </div>

                    <% } %>

                  </td>


                  <td>

                    <strong>
                      ₹<%= Number(product.price || 0).toLocaleString("en-IN") %>
                    </strong>

                    <% if (product.original_price) { %>

                      <div class="help">
                        ₹<%= Number(product.original_price).toLocaleString("en-IN") %>
                      </div>

                    <% } %>

                  </td>


                  <td>
                    <%= product.discount || "-" %>
                  </td>


                  <td>

                    <span class="rating">
                      ⭐ <%= product.rating || "0" %>
                    </span>

                  </td>


                  <td>
                    <%= product.clicks || 0 %>
                  </td>


                  <td>

                    <% if (Number(product.visible) === 1) { %>

                      <span class="badge badge-green">
                        Visible
                      </span>

                    <% } else { %>

                      <span class="badge badge-red">
                        Hidden
                      </span>

                    <% } %>


                    <% if (Number(product.featured) === 1) { %>

                      <span class="badge badge-orange">
                        Featured
                      </span>

                    <% } %>

                  </td>


                  <td>

                    <div class="actions">

                      <a
                        href="/admin/edit/<%= product.id %>"
                        class="btn btn-blue btn-small"
                      >
                        ✏️ Edit
                      </a>


                      <a
                        href="/product/<%= product.id %>"
                        target="_blank"
                        class="btn btn-gray btn-small"
                      >
                        👁️ View
                      </a>


                      <form
                        action="/admin/delete/<%= product.id %>"
                        method="POST"
                        onsubmit="return confirm('Delete this product?');"
                        style="display:inline"
                      >

                        <button
                          type="submit"
                          class="btn btn-red btn-small"
                        >
                          🗑️ Delete
                        </button>

                      </form>

                    </div>

                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        <% } %>

      </div>

    </section>


    <!-- CATEGORIES -->
    <section class="section" id="categories">

      <div class="section-header">

        <h2>📂 Categories</h2>

      </div>


      <div class="section-body">

        <form
          action="/admin/categories/add"
          method="POST"
          enctype="multipart/form-data"
        >

          <div class="grid-2">

            <div class="form-group">

              <label>New Category Name *</label>

              <input
                type="text"
                name="name"
                placeholder="Example: Smart Watches"
                required
              >

            </div>


            <div class="form-group">

              <label>Category Image</label>

              <input
                type="file"
                name="category_image"
                accept="image/jpeg,image/png,image/webp"
              >

              <div class="help">
                Upload JPG, PNG or WEBP image. Max 5MB.
              </div>

            </div>

          </div>


          <button
            type="submit"
            class="btn btn-primary"
          >
            ➕ Add Category
          </button>

        </form>


        <div class="table-wrap">

          <% if (categoryList.length === 0) { %>

            <div class="empty">
              No categories found.
            </div>

          <% } else { %>

            <table>

              <thead>

                <tr>

                  <th>Image</th>
                  <th>ID</th>
                  <th>Category Name</th>
                  <th>Actions</th>

                </tr>

              </thead>


              <tbody>

                <% categoryList.forEach(category => { %>

                  <tr>

                    <!-- CATEGORY IMAGE -->
                    <td>

                      <% if (category.image_url) { %>

                        <img
                          src="<%= category.image_url %>"
                          class="product-img"
                          alt="<%= category.name %>"
                          onerror="this.style.display='none'"
                        >

                      <% } else { %>

                        <div
                          class="product-img"
                          style="
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            color:#999;
                            font-size:20px;
                          "
                        >
                          📂
                        </div>

                      <% } %>

                    </td>


                    <!-- ID -->
                    <td>
                      <%= category.id %>
                    </td>


                    <!-- CATEGORY NAME -->
                    <td>

                      <strong>
                        <%= category.name %>
                      </strong>

                    </td>


                    <!-- ACTIONS -->
                    <td>

                      <div class="actions">

                        <!-- EDIT CATEGORY -->
                        <form
                          action="/admin/categories/edit/<%= category.id %>"
                          method="POST"
                          enctype="multipart/form-data"
                          style="
                            display:flex;
                            flex-wrap:wrap;
                            gap:5px;
                            align-items:center;
                          "
                        >

                          <input
                            type="text"
                            name="name"
                            value="<%= category.name %>"
                            required
                            style="max-width:200px;"
                          >


                          <input
                            type="file"
                            name="category_image"
                            accept="image/jpeg,image/png,image/webp"
                            style="max-width:220px;"
                          >


                          <button
                            type="submit"
                            class="btn btn-blue btn-small"
                          >
