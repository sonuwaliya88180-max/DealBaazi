<!-- ======================================================
     BANNER MANAGER
====================================================== -->

<section
  class="section"
  id="banners"
>

  <div class="section-title">

    <div>

      <h2>
        🖼️ Banner Manager
      </h2>

      <p>
        Homepage ke promotional banners yahin se add aur manage karo.
      </p>

    </div>

  </div>


  <!-- ADD BANNER -->

  <form
    class="banner-form"
    action="/admin/banners/add"
    method="POST"
    enctype="multipart/form-data"
  >

    <h3 style="margin-bottom:15px;">
      ➕ Add New Banner
    </h3>


    <div class="form-grid">

      <div class="form-group">

        <label>
          Banner Image
        </label>

        <input
          type="file"
          name="banner_image"
          accept="image/jpeg,image/png,image/webp"
        >

      </div>


      <div class="form-group">

        <label>
          Image URL
        </label>

        <input
          type="text"
          name="image_url"
          placeholder="https://example.com/banner.jpg"
        >

      </div>


      <div class="form-group">

        <label>
          Heading
        </label>

        <input
          type="text"
          name="heading"
          placeholder="Big Sale Today"
        >

      </div>


      <div class="form-group">

        <label>
          Button Text
        </label>

        <input
          type="text"
          name="button_text"
          placeholder="Shop Now"
        >

      </div>


      <div class="form-group full">

        <label>
          Description
        </label>

        <textarea
          name="description"
          placeholder="Banner description"
        ></textarea>

      </div>


      <div class="form-group">

        <label>
          Button / Banner Link
        </label>

        <input
          type="text"
          name="link_url"
          placeholder="https://example.com/deal"
        >

      </div>


      <div class="form-group">

        <label>
          Sort Order
        </label>

        <input
          type="number"
          name="sort_order"
          value="0"
        >

      </div>

    </div>


    <div class="checkbox-row">

      <label class="checkbox">

        <input
          type="checkbox"
          name="active"
          checked
        >

        Active

      </label>

    </div>


    <button
      type="submit"
      class="btn btn-primary"
      style="margin-top:15px;"
    >
      ➕ Add Banner
    </button>

  </form>


  <!-- BANNER LIST -->

  <div class="banner-list">

    <% if (banners && banners.length) { %>

      <% banners.forEach(function(banner) { %>

        <div class="banner-card">

          <div class="banner-image">

            <% if (banner.image_url) { %>

              <img
                src="<%= banner.image_url %>"
                alt="<%= banner.heading || 'Banner' %>"
              >

            <% } else { %>

              <span>
                No Image
              </span>

            <% } %>

          </div>


          <div class="banner-content">

            <span
              class="status <%= banner.active ? 'active' : 'inactive' %>"
            >
              <%= banner.active ? 'ACTIVE' : 'INACTIVE' %>
            </span>


            <h3>
              <%= banner.heading || 'Untitled Banner' %>
            </h3>


            <% if (banner.description) { %>

              <p>
                <%= banner.description %>
              </p>

            <% } %>


            <% if (banner.button_text) { %>

              <p>
                <strong>
                  Button:
                </strong>

                <%= banner.button_text %>
              </p>

            <% } %>


            <% if (banner.link_url) { %>

              <p style="word-break:break-all;">
                <strong>
                  Link:
                </strong>

                <%= banner.link_url %>
              </p>

            <% } %>


            <div class="banner-actions">

              <button
                type="button"
                class="btn btn-secondary btn-small"
                onclick="openBannerEdit(<%= banner.id %>)"
              >
                ✏️ Edit
              </button>


              <form
                action="/admin/banners/toggle/<%= banner.id %>"
                method="POST"
                style="display:inline;"
              >

                <button
                  class="btn btn-success btn-small"
                  type="submit"
                >
                  <%= banner.active
                    ? '⏸ Disable'
                    : '▶ Enable'
                  %>
                </button>

              </form>


              <form
                action="/admin/banners/delete/<%= banner.id %>"
                method="POST"
                style="display:inline;"
                onsubmit="return confirm('Delete this banner?')"
              >

                <button
                  class="btn btn-danger btn-small"
                  type="submit"
                >
                  🗑 Delete
                </button>

              </form>

            </div>

          </div>

        </div>


        <!-- Hidden edit form -->

        <div
          id="banner-edit-<%= banner.id %>"
          style="display:none;"
        >

          <form
            action="/admin/banners/edit/<%= banner.id %>"
            method="POST"
            enctype="multipart/form-data"
          >

            <input
              type="hidden"
              name="image_url"
              value="<%= banner.image_url || '' %>"
            >

            <input
              type="hidden"
              name="heading"
              value="<%= banner.heading || '' %>"
            >

            <input
              type="hidden"
              name="description"
              value="<%= banner.description || '' %>"
            >

            <input
              type="hidden"
              name="button_text"
              value="<%= banner.button_text || '' %>"
            >

            <input
              type="hidden"
              name="link_url"
              value="<%= banner.link_url || '' %>"
            >

            <input
              type="hidden"
              name="sort_order"
              value="<%= banner.sort_order || 0 %>"
            >

          </form>

        </div>

      <% }) %>

    <% } else { %>

      <div
        style="
          padding:25px;
          text-align:center;
          color:#777;
          border:1px dashed #ddd;
          border-radius:10px;
        "
      >
        Abhi koi banner add nahi kiya gaya.
      </div>

    <% } %>

  </div>

</section>


