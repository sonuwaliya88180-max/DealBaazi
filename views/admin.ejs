<script>

  async function fetchProduct() {

    const urlInput =
      document.getElementById("fetchAffiliateUrl");

    const status =
      document.getElementById("fetchStatus");

    const affiliateUrl =
      urlInput.value.trim();


    if (!affiliateUrl) {

      showFetchStatus(
        "Please paste an affiliate/product URL first.",
        false
      );

      return;
    }


    status.className =
      "fetch-status show";

    status.textContent =
      "⏳ Fetching product information...";


    try {

      const response =
        await fetch(
          "/admin/fetch-product",
          {
            method: "POST",

            headers: {
              "Content-Type": "application/json"
            },

            body: JSON.stringify({
              affiliate_url: affiliateUrl
            })
          }
        );


      /*
        IMPORTANT:
        Response ko sirf ek baar read karna hai.
        Isse JSON / 403 response par JS error nahi aayega.
      */
      const responseText =
        await response.text();


      let data;

      try {

        data =
          JSON.parse(responseText);

      } catch (parseError) {

        throw new Error(
          `Server returned an invalid response (HTTP ${response.status}).`
        );

      }


      /*
        MEESHO 403
      */
      if (
        data.store === "Meesho" &&
        data.success === false &&
        (
          response.status === 403 ||
          String(data.error || "")
            .toLowerCase()
            .includes("403")
        )
      ) {

        showFetchStatus(
          "⚠️ Meesho automatic fetching is blocked (HTTP 403). Please enter the product details manually.",
          "warning"
        );

        return;
      }


      /*
        Other server errors
      */
      if (!response.ok) {

        throw new Error(
          data.error ||
          `Unable to fetch product (HTTP ${response.status}).`
        );

      }


      if (!data.success) {

        throw new Error(
          data.error ||
          "Product information could not be fetched."
        );

      }


      /*
        FILL PRODUCT DETAILS
      */
      document.getElementById("productName").value =
        data.name || "";


      document.getElementById("productPrice").value =
        data.price || "";


      document.getElementById("productOriginalPrice").value =
        data.original_price || "";


      document.getElementById("productDiscount").value =
        data.discount || "";


      document.getElementById("productRating").value =
        data.rating || "";


      document.getElementById("productImageUrl").value =
        data.image_url || "";


      document.getElementById("productDescription").value =
        data.description || "";


      document.getElementById("productAffiliateUrl").value =
        data.affiliate_url ||
        data.original_url ||
        affiliateUrl;


      showFetchStatus(
        "✅ Product information fetched successfully. Please check the details before adding.",
        true
      );


    } catch (error) {

      console.error(
        "Affiliate fetch error:",
        error
      );


      showFetchStatus(
        "❌ " +
        (
          error.message ||
          "Unable to fetch product."
        ),
        false
      );

    }

  }


  function showFetchStatus(message, type) {

    const status =
      document.getElementById("fetchStatus");


    status.className =
      "fetch-status show";


    if (type === true || type === "success") {

      status.classList.add(
        "fetch-success"
      );

    } else if (type === "warning") {

      status.classList.add(
        "fetch-warning"
      );

    } else {

      status.classList.add(
        "fetch-error"
      );

    }


    status.textContent =
      message;

  }


  document
    .getElementById("addProductForm")
    .addEventListener(
      "submit",
      function() {

        const button =
          this.querySelector(
            'button[type="submit"]'
          );


        if (button) {

          button.disabled = true;

          button.textContent =
            "⏳ Adding Product...";

        }

      }
    );


  // Smooth scrolling
  document
    .querySelectorAll(
      '.nav-link[href^="#"]'
    )
    .forEach(
      link => {

        link.addEventListener(
          "click",
          function(e) {

            const target =
              document.querySelector(
                this.getAttribute("href")
              );


            if (target) {

              e.preventDefault();


              target.scrollIntoView({
                behavior: "smooth"
              });

            }

          }
        );

      }
    );

</script>

