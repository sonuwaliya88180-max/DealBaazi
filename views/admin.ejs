<section
  class="section"
  id="add-product"
>

  <div class="section-title">

    <div>

      <h2>
        ➕ Add Product
      </h2>

      <p>
        New affiliate deal add karo.
      </p>

    </div>

  </div>


  <form
    action="/admin/add"
    method="POST"
    enctype="multipart/form-data"
  >

    <div class="form-grid">

      <div class="form-group full">

        <label>
          Product Name
        </label>

        <input
          type="text"
          name="name"
          required
          placeholder="Product name"
        >

      </div>


      <div class="form-group">

        <label>
          Selling Price
        </label>

        <input
          type="number"
          step="0.01"
          id="sellingPrice"
          name="sellingPrice"
          required
          placeholder="999"
        >

      </div>


      <div class="form-group">

        <label>
          Original Price
        </label>

        <input
          type="number"
          step="0.01"
          id="originalPrice"
          name="originalPrice"
          placeholder="1499"
        >

      </div>


      <div class="form-group">

        <label>
          Discount
        </label>

        <input
          type="text"
          id="discountPreview"
          readonly
          placeholder="Auto calculated"
        >

        <input
          type="hidden"
          id="discountHidden"
          name="discount"
        >

      </div>


      <div class="form-group">

        <label>
          Rating
        </label>

        <input
          type="number"
          step="0.1"
          min="0"
          max="5"
          name="rating"
          value="4.5"
        >

      </div>


      <div class="form-group">

        <label>
          Category
        </label>

        <select name="category_id">

          <option value="">
            Select Category
          </option>

          <% categories.forEach(function(category) { %>

            <option
              value="<%= category.id %>"
            >
              <%= category.name %>
            </option>

          <% }) %>

        </select>

      </div>


      <div class="form-group">

        <label>
          Affiliate URL
        </label>

        <input
          type="url"
          name="affiliate_url"
          required
          placeholder="https://..."
        >

      </div>


      <div class="form-group">

        <label>
          Expiry Date
        </label>

        <input
          type="date"
          name="expiry_date"
        >

      </div>


      <div class="form-group full">

        <label>
          Description
        </label>

        <textarea
          name="description"
          placeholder="Product description"
        ></textarea>

      </div>


      <div class="form-group full">

        <label>
          Product Images
        </label>

        <input
          type="file"
          name="images"
          id="productImages"
          accept="image/jpeg,image/png,image/webp"
          multiple
        >

        <div
          id="imagePreview"
          style="
            display:flex;
            gap:8px;
            flex-wrap:wrap;
            margin-top:10px;
          "
        ></div>

      </div>

    </div>


    <div class="checkbox-row">

      <label class="checkbox">
        <input
          type="checkbox"
          name="featured"
        >
        Featured
      </label>

      <label class="checkbox">
        <input
          type="checkbox"
          name="trending"
        >
        Trending
      </label>

      <label class="checkbox">
        <input
          type="checkbox"
          name="hot_deal"
        >
        Hot Deal
      </label>

      <label class="checkbox">
        <input
          type="checkbox"
          name="visible"
          checked
        >
        Visible
      </label>

    </div>


    <button
      type="submit"
      class="btn btn-primary"
      style="margin-top:18px;"
    >
      ➕ Add Product
    </button>

  </form>

</section>


