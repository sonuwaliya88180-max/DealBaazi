</nav>


<script>

  /* =====================================================
     DISCOUNT CALCULATOR
  ===================================================== */

  const sellingPrice =
    document.getElementById(
      "sellingPrice"
    );

  const originalPrice =
    document.getElementById(
      "originalPrice"
    );

  const discountPreview =
    document.getElementById(
      "discountPreview"
    );

  const discountHidden =
    document.getElementById(
      "discountHidden"
    );


  function calculateDiscount() {

    if (
      !sellingPrice ||
      !originalPrice
    ) {
      return;
    }

    const selling =
      Number(
        sellingPrice.value || 0
      );

    const original =
      Number(
        originalPrice.value || 0
      );

    if (
      original > selling &&
      selling > 0
    ) {

      const percent =
        Math.round(
          ((original - selling) /
            original) *
          100
        );

      const text =
        percent + "% OFF";

      discountPreview.value =
        text;

      discountHidden.value =
        text;

    } else {

      discountPreview.value =
        "";

      discountHidden.value =
        "";

    }

  }


  if (sellingPrice) {
    sellingPrice.addEventListener(
      "input",
      calculateDiscount
    );
  }

  if (originalPrice) {
    originalPrice.addEventListener(
      "input",
      calculateDiscount
    );
  }


  /* =====================================================
     IMAGE PREVIEW
  ===================================================== */

  const productImages =
    document.getElementById(
      "productImages"
    );

  const imagePreview =
    document.getElementById(
      "imagePreview"
    );


  if (productImages) {

    productImages.addEventListener(
      "change",
      function () {

        imagePreview.innerHTML = "";

        Array.from(
          productImages.files
        ).forEach(file => {

          const reader =
            new FileReader();

          reader.onload =
            function (event) {

              const img =
                document.createElement(
                  "img"
                );

              img.src =
                event.target.result;

              img.style.width =
                "75px";

              img.style.height =
                "75px";

              img.style.objectFit =
                "contain";

              img.style.border =
                "1px solid #ddd";

              img.style.borderRadius =
                "8px";

              img.style.padding =
                "3px";

              imagePreview.appendChild(
                img
              );

            };

          reader.readAsDataURL(
            file
          );

        });

      }
    );

  }


  /* =====================================================
     PRODUCT SEARCH
  ===================================================== */

  const productSearch =
    document.getElementById(
      "productSearch"
    );

  const categoryFilter =
    document.getElementById(
      "categoryFilter"
    );

  const statusFilter =
    document.getElementById(
      "statusFilter"
    );


  function filterProducts() {

    const search =
      (
        productSearch.value || ""
      )
      .toLowerCase()
      .trim();

    const category =
      categoryFilter.value;

    const status =
      statusFilter.value;


    document
      .querySelectorAll(
        ".product-row"
      )
      .forEach(row => {

        const name =
          row.dataset.name || "";

        const rowCategory =
          row.dataset.category || "";

        const visible =
          row.dataset.visible === "1";

        const hot =
          row.dataset.hot === "1";

        const featured =
          row.dataset.featured === "1";


        let show = true;


        if (
          search &&
          !name.includes(search)
        ) {
          show = false;
        }


        if (
          category &&
          rowCategory !== category
        ) {
          show = false;
        }


        if (
          status === "visible" &&
          !visible
        ) {
          show = false;
        }


        if (
          status === "hidden" &&
          visible
        ) {
          show = false;
        }


        if (
          status === "hot" &&
          !hot
        ) {
          show = false;
        }


        if (
          status === "featured" &&
          !featured
        ) {
          show = false;
        }


        row.style.display =
          show ? "" : "none";

      });

  }


  if (productSearch) {

    productSearch.addEventListener(
      "input",
      filterProducts
    );

  }


  if (categoryFilter) {

    categoryFilter.addEventListener(
      "change",
      filterProducts
    );

  }


  if (statusFilter) {

    statusFilter.addEventListener(
      "change",
      filterProducts
    );

  }


  /* =====================================================
     CATEGORY MODAL
  ===================================================== */

  function openCategoryModal(
    id,
    name,
    sortOrder,
    active
  ) {

    document.getElementById(
      "categoryModal"
    ).classList.add("show");


    document.getElementById(
      "categoryEditForm"
    ).action =
      "/admin/categories/edit/" +
      id;


    document.getElementById(
      "editCategoryName"
    ).value = name;


    document.getElementById(
      "editCategoryOrder"
    ).value = sortOrder;


    document.getElementById(
      "editCategoryActive"
    ).checked =
      Number(active) === 1;

  }


  function closeCategoryModal() {

    document.getElementById(
      "categoryModal"
    ).classList.remove("show");

  }


  /* =====================================================
     BANNER DATA
  ===================================================== */

  const bannerData = {

    <% if (banners && banners.length) { %>

      <% banners.forEach(function(banner, index) { %>

        "<%= banner.id %>": {

          image_url:
            <%- JSON.stringify(banner.image_url || '') %>,

          heading:
            <%- JSON.stringify(banner.heading || '') %>,

          description:
            <%- JSON.stringify(banner.description || '') %>,

          button_text:
            <%- JSON.stringify(banner.button_text || '') %>,

          link_url:
            <%- JSON.stringify(banner.link_url || '') %>,

          sort_order:
            <%= Number(banner.sort_order || 0) %>,

          active:
            <%= Number(banner.active || 0) %>

        }<%= index < banners.length - 1 ? ',' : '' %>

      <% }) %>

    <% } %>

  };


  function openBannerEdit(id) {

    const banner =
      bannerData[String(id)];

    if (!banner) {
      return;
    }


    document.getElementById(
      "bannerModal"
    ).classList.add("show");


    document.getElementById(
      "bannerEditForm"
    ).action =
      "/admin/banners/edit/" +
      id;


    document.getElementById(
      "editBannerImageUrl"
    ).value =
      banner.image_url;


    document.getElementById(
      "editBannerHeading"
    ).value =
      banner.heading;


    document.getElementById(
      "editBannerDescription"
    ).value =
      banner.description;


    document.getElementById(
      "editBannerButton"
    ).value =
      banner.button_text;


    document.getElementById(
      "editBannerLink"
    ).value =
      banner.link_url;


    document.getElementById(
      "editBannerOrder"
    ).value =
      banner.sort_order;


    document.getElementById(
      "editBannerActive"
    ).checked =
      Number(banner.active) === 1;

  }


  function closeBannerModal() {

    document.getElementById(
      "bannerModal"
    ).classList.remove("show");

  }


  /* =====================================================
     CLOSE MODALS ON BACKDROP
  ===================================================== */

  window.addEventListener(
    "click",
    function(event) {

      const categoryModal =
        document.getElementById(
          "categoryModal"
        );

      const bannerModal =
        document.getElementById(
          "bannerModal"
        );


      if (
        event.target ===
        categoryModal
      ) {
        closeCategoryModal();
      }


      if (
        event.target ===
        bannerModal
      ) {
        closeBannerModal();
      }

    }
  );

</script>

</body>
</html>