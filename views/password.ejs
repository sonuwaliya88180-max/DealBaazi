<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Change Password - DealBaazi</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f5f6fa;
      padding: 20px;
    }

    .box {
      width: 100%;
      max-width: 420px;
      background: white;
      padding: 30px;
      border-radius: 16px;
      box-shadow: 0 5px 25px rgba(0,0,0,0.10);
    }

    h1 {
      text-align: center;
      color: #ff5a00;
      margin-bottom: 8px;
    }

    .subtitle {
      text-align: center;
      color: #777;
      margin-bottom: 25px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 7px;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #ddd;
      border-radius: 9px;
      margin-bottom: 18px;
      font-size: 15px;
      outline: none;
    }

    input:focus {
      border-color: #ff5a00;
      box-shadow: 0 0 0 2px rgba(255,90,0,0.10);
    }

    button {
      width: 100%;
      padding: 13px;
      border: none;
      border-radius: 9px;
      background: #ff5a00;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #e94f00;
    }

    .back {
      display: block;
      text-align: center;
      margin-top: 18px;
      color: #ff5a00;
      text-decoration: none;
      font-weight: bold;
    }

    .message {
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 18px;
      text-align: center;
      font-size: 14px;
      font-weight: bold;
    }

    .error {
      background: #ffe5e5;
      color: #c62828;
    }

    .success {
      background: #e5f8eb;
      color: #218838;
    }
  </style>
</head>

<body>

  <div class="box">

    <h1>🔐 DealBaazi</h1>

    <div class="subtitle">
      Change Admin Password
    </div>

    <% if (typeof error !== "undefined" && error) { %>
      <div class="message error">
        ❌ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== "undefined" && success) { %>
      <div class="message success">
        ✅ <%= success %>
      </div>
    <% } %>

    <!-- IMPORTANT:
         This form matches the existing /password POST route
    -->
    <form action="/password" method="POST">

      <label>Current Password</label>

      <input
        type="password"
        name="old_password"
        placeholder="Current password"
        autocomplete="current-password"
        required
      >

      <label>New Password</label>

      <input
        type="password"
        name="new_password"
        placeholder="New password"
        minlength="6"
        autocomplete="new-password"
        required
      >

      <label>Confirm New Password</label>

      <input
        type="password"
        name="confirm_password"
        placeholder="Confirm new password"
        minlength="6"
        autocomplete="new-password"
        required
      >

      <button type="submit">
        🔒 Change Password
      </button>

    </form>

    <a href="/admin" class="back">
      ← Back to Admin Panel
    </a>

  </div>

</body>
</html>
