                      <% } %>

                    </div>

                    <% if (savingAmount > 0) { %>

                      <div class="saving">
                        You Save ₹<%= Number(savingAmount).toLocaleString('en-IN') %>
                      </div>

                    <% } %>

                    <div class="product-buttons">

                      <a
                        href="/product/<%= product.id %>"
                        class="details-btn"
                      >
                        Details
                      </a>

                      <a
                        href="/buy/<%= product.id %>"
                        class="buy-btn"
                      >
                        BUY NOW
                      </a>

                    </div>

                  </div>

                </article>

              <% }) %>

            </div>


          <% } else { %>

            <div class="empty-box">

              <div class="empty-icon">
                🛍️
              </div>

              <h2>
                No deals available right now
              </h2>

              <p>
                Admin panel se products add karne ke baad
