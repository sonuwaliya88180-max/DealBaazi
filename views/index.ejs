<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>DealBaazi - Best Deals & Offers</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6f9;
      color: #222;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button,
    input {
      font-family: inherit;
    }

    /* =====================================================
       TOP BAR
    ===================================================== */

    .topbar {
      background: #111827;
      color: white;
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 10px 25px;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 12px rgba(0,0,0,.18);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: max-content;
    }

    .brand img {
      width: 42px;
      height: 42px;
      object-fit: contain;
      background: white;
      border-radius: 7px;
      padding: 3px;
    }

    .brand-text {
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -.5px;
    }

    .brand-text span {
      color: #ff6b00;
    }

    /* SEARCH */

    .header-search {
      flex: 1;
      max-width: 650px;
    }

    .search-form {
      display: flex;
      width: 100%;
      background: white;
      border-radius: 8px;
      overflow: hidden;
    }

    .search-form input {
      flex: 1;
      border: none;
      outline: none;
      padding: 12px 14px;
      font-size: 14px;
      color: #222;
      min-width: 0;
    }

    .search-form button {
      border: none;
      background: #ff6b00;
      color: white;
      padding: 0 18px;
      cursor: pointer;
      font-weight: 700;
    }

    .search-form button:hover {
      background: #e85d00;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .top-btn {
      background: #374151;
      color: white;
      padding: 10px 14px;
      border-radius: 7px;
      font-size: 14px;
      font-weight: 700;
      white-space: nowrap;
    }

    .top-btn:hover {
      background: #4b5563;
    }

    .top-btn.home {
      background: #ff6b00;
    }

    /* =====================================================
       CATEGORY BAR
    ===================================================== */

    .category-bar {
      background: #1f2937;
      color: white;
      padding: 10px 20px;
      overflow-x: auto;
      white-space: nowrap;
      box-shadow: 0 2px 6px rgba(0,0,0,.12);
    }

    .category-inner {
      max-width: 1500px;
      margin: auto;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .category-title {
      color: #9ca3af;
      font-size: 12px;
      text-transform: uppercase;
      font-weight: 700;
      margin-right: 7px;
    }

    .category-link {
      padding: 8px 12px;
      border-radius: 6px;
      color: #e5e7eb;
      font-size: 13px;
      font-weight: 600;
    }

    .category-link:hover,
    .category-link.active {
      background: #ff6b00;
      color: white;
    }

    /* =====================================================
       MAIN
    ===================================================== */

    .main {
      width: 100%;
      max-width: 1500px;
      margin: auto;
      padding: 25px;
    }

    /* =====================================================
       HERO
    ===================================================== */

    .hero {
      background: #111827;
      color: white;
      min-height: 300px;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 25px;
      display: grid;
      grid-template-columns: 1.15fr .85fr;
      box-shadow: 0 3px 12px rgba(0,0,0,.12);
    }

    .hero-content {
      padding: 45px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .hero-label {
      display: inline-block;
      width: max-content;
      background: #ff6b00;
      padding: 7px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 15px;
    }

    .hero h1 {
      font-size: 38px;
      line-height: 1.12;
      margin-bottom: 12px;
    }

    .hero p {
      color: #d1d5db;
      font-size: 16px;
      line-height: 1.6;
      max-width: 650px;
      margin-bottom: 22px;
    }

    .hero-btn {
      width: max-content;
      background: #ff6b00;
      color: white;
      padding: 12px 20px;
      border-radius: 7px;
      font-weight: 800;
      font-size: 14px;
    }

    .hero-btn:hover {
      background: #e85d00;
    }

    .hero-image {
      min-height: 300px;
      background: #1f2937;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .hero-image img {
      width: 100%;
      height: 100%;
      max-height: 350px;
      object-fit: cover;
    }

    /* =====================================================
       DASHBOARD STYLE HIGHLIGHTS
    ===================================================== */

    .quick-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 25px;
    }

    .quick-card {
      background: white;
      border-radius: 10px;
      padding: 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      box-shadow: 0 2px 8px rgba(0,0,0,.07);
      border-left: 4px solid #ff6b00;
    }

    .quick-icon {
      width: 45px;
      height: 45px;
      border-radius: 8px;
      background: #fff1e8;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    .quick-card h3 {
      font-size: 16px;
      margin-bottom: 4px;
    }

    .quick-card p {
      color: #6b7280;
      font-size: 12px;
    }

    /* =====================================================
       SECTION
    ===================================================== */

    .section {
      background: white;
      border-radius: 10px;
      margin-bottom: 25px;
      box-shadow: 0 2px 8px rgba(0,0,0,.06);
      overflow: hidden;
    }

    .section-header {
      padding: 17px 20px;
      border-bottom: 1px solid #eee;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .section-header h2 {
      font-size: 19px;
    }

    .section-header p {
      color: #6b7280;
      font-size: 12px;
      margin-top: 4px;
    }

    .section-link {
      color: #ff6b00;
      font-size: 13px;
      font-weight: 700;
    }

    .section-body {
      padding: 20px;
    }

    /* =====================================================
       CATEGORIES
    ===================================================== */

    .category-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 12px;
    }

    .category-card {
      background: #f9fafb;
      border: 1px solid #eee;
      border-radius: 8px;
      padding: 17px 10px;
      text-align: center;
      font-size: 13px;
      font-weight: 700;
      transition: .2s;
    }

    .category-card:hover {
      border-color: #ff6b00;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }

    .category-card .icon {
      font-size: 25px;
      margin-bottom: 8px;
      display: block;
    }

    /* =====================================================
       BANNERS
    ===================================================== */

    .banner-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .banner-card {
      position: relative;
      min-height: 170px;
      border-radius: 9px;
      overflow: hidden;
      background: #1f2937;
    }

    .banner-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .banner-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(17,24,39,.92),
        rgba(17,24,39,.12)
      );
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 18px;
      color: white;
    }

    .banner-overlay h3 {
      font-size: 18px;
      margin-bottom: 4px;
    }

    .banner-overlay p {
      color: #e5e7eb;
      font-size: 12px;
      margin-bottom: 10px;
    }

    .banner-btn {
      display: inline-block;
      width: max-content;
      background: #ff6b00;
      padding: 7px 11px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 800;
    }

    /* =====================================================
       PRODUCT GRID
    ===================================================== */

    .product-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 15px;
    }

    .product-card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 9px;
      overflow: hidden;
      position: relative;
      transition: .2s;
    }

    .product-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 7px 18px rgba(0,0,0,.10);
      border-color: #ff6b00;
    }

    .product-image-wrap {
      height: 190px;
      background: #f8f8f8;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px;
    }

    .product-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .deal-badge {
      position: absolute;
      left: 8px;
      top: 8px;
      background: #ff6b00;
      color: white;
      border-radius: 5px;
      padding: 5px 7px;
      font-size: 10px;
      font-weight: 800;
    }

    .featured-badge {
      position: absolute;
      right: 8px;
      top: 8px;
      background: #111827;
      color: white;
      border-radius: 5px;
      padding: 5px 7px;
      font-size: 10px;
      font-weight: 800;
    }

    .product-content {
      padding: 13px;
    }

    .product-category {
      color: #6b7280;
      font-size: 10px;
      margin-bottom: 5px;
      text-transform: uppercase;
      font-weight: 700;
    }

    .product-name {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.4;
      height: 39px;
      overflow: hidden;
      margin-bottom: 8px;
    }

    .rating {
      color: #f59e0b;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .price-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 10px;
    }

    .sale-price {
      font-size: 18px;
      font-weight: 800;
      color: #111827;
    }

    .original-price {
      color: #9ca3af;
      text-decoration: line-through;
      font-size: 12px;
    }

    .discount {
      color: #16a34a;
      font-size: 11px;
      font-weight: 800;
    }

    .product-actions {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 6px;
    }

    .view-btn,
    .buy-btn {
      text-align: center;
      padding: 9px 5px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 800;
    }

    .view-btn {
      background: #f3f4f6;
      color: #374151;
    }

    .buy-btn {
      background: #ff6b00;
      color: white;
    }

    .buy-btn:hover {
      background: #e85d00;
    }

    /* =====================================================
       SEARCH / CATEGORY PAGE
    ===================================================== */

    .result-heading {
      margin-bottom: 18px;
    }

    .result-heading h1 {
      font-size: 25px;
      margin-bottom: 5px;
    }

    .result-heading p {
      color: #6b7280;
      font-size: 13px;
    }

    /* =====================================================
       EMPTY
    ===================================================== */

    .empty {
      text-align: center;
      padding: 40px 20px;
      color: #777;
    }

    .empty-icon {
      font-size: 40px;
      margin-bottom: 10px;
    }

    /* =====================================================
       FOOTER
    ===================================================== */

    footer {
      background: #111827;
      color: white;
      margin-top: 30px;
    }

    .footer-inner {
      max-width: 1500px;
      margin: auto;
      padding: 35px 25px;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 30px;
    }

    .footer-brand {
      font-size: 23px;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .footer-brand span {
      color: #ff6b00;
    }

    .footer-text {
      color: #9ca3af;
      font-size: 13px;
      line-height: 1.6;
      max-width: 500px;
    }

    .footer-column h3 {
      font-size: 14px;
      margin-bottom: 12px;
    }

    .footer-column a {
      display: block;
      color: #9ca3af;
      font-size: 12px;
      margin-bottom: 8px;
    }

    .footer-column a:hover {
      color: #ff6b00;
    }

    .copyright {
      border-top: 1px solid #374151;
      text-align: center;
      color: #9ca3af;
      padding: 15px;
      font-size: 12px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 1200px) {

      .product-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .category-grid {
        grid-template-columns: repeat(4, 1fr);
      }

    }

    @media (max-width: 1000px) {

      .topbar {
        flex-wrap: wrap;
      }

      .header-search {
        order: 3;
        flex-basis: 100%;
        max-width: none;
      }

      .quick-stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .hero {
        grid-template-columns: 1fr;
      }

      .hero-image {
        min-height: 220px;
      }

      .banner-grid {
        grid-template-columns: 1fr 1fr;
      }

      .product-grid {
        grid-template-columns: repeat(3, 1fr);
      }

    }

    @media (max-width: 700px) {

      .topbar {
        padding: 10px 12px;
        gap: 10px;
      }

      .brand-text {
        font-size: 21px;
      }

      .brand img {
        width: 36px;
        height: 36px;
      }

      .top-actions .top-btn:not(.home) {
        display: none;
      }

      .top-btn {
        padding: 9px 11px;
      }

      .category-bar {
        padding: 8px 10px;
      }

      .main {
        padding: 12px;
      }

      .hero {
        margin-bottom: 15px;
        min-height: auto;
      }

      .hero-content {
        padding: 27px 22px;
      }

      .hero h1 {
        font-size: 28px;
      }

      .hero p {
        font-size: 14px;
      }

      .hero-image {
        min-height: 180px;
      }

      .quick-stats {
        grid-template-columns: 1fr 1fr;
        gap: 9px;
      }

      .quick-card {
        padding: 12px;
        gap: 9px;
      }

      .quick-icon {
        width: 38px;
        height: 38px;
        font-size: 18px;
      }

      .quick-card h3 {
        font-size: 13px;
      }

      .quick-card p {
        font-size: 10px;
      }

      .section {
        margin-bottom: 15px;
      }

      .section-header {
        padding: 14px;
      }

      .section-header h2 {
        font-size: 16px;
      }

      .section-body {
        padding: 12px;
      }

      .category-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
      }

      .banner-grid {
        grid-template-columns: 1fr;
      }

      .product-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
      }

      .product-image-wrap {
        height: 150px;
      }

      .product-content {
        padding: 10px;
      }

      .product-name {
        font-size: 12px;
        height: 35px;
      }

      .sale-price {
        font-size: 15px;
      }

      .original-price {
        font-size: 10px;
      }

      .discount {
        font-size: 9px;
      }

      .product-actions {
        grid-template-columns: 1fr;
      }

      .view-btn,
      .buy-btn {
        padding: 8px 4px;
      }

      .footer-inner {
        grid-template-columns: 1fr;
        padding: 25px 15px;
        gap: 20px;
      }

    }

    @media (max-width: 400px) {

      .product-grid {
        grid-template-columns: 1fr 1fr;
      }

      .product-image-wrap {
        height: 135px;
      }

      .hero h1 {
        font-size: 25px;
      }

    }
  </style>
</head>

<body>

<%
  const safeSettings = siteSettings || {};
  const productList = products || [];
  const categoryList = categories || [];
  const bannerList = banners || [];
  const hotDealList = hotDeals || [];
  const topPickList = topPicks || [];
  const topRatedList = topRated || [];

  function getSetting(key, fallback = "") {
    if (
      safeSettings &&
      typeof safeSettings === "object" &&
      safeSettings[key] !== undefined &&
      safeSettings[key] !== null &&
      safeSettings[key] !== ""
    ) {
      return safeSettings[key];
    }

    return fallback;
  }

  function discountValue(product) {

    if (product.discount) {
      return product.discount;
    }

    const original = Number(product.original_price || 0);
    const price = Number(product.price || 0);

    if (original > price && price > 0) {
      const discount = Math.round(
        ((original - price) / original) * 100
      );

      return discount + "% OFF";
    }

    return "";
  }

  const logoValue =
    getSetting("logo_url",
      getSetting("logo", "/images/logo.png")
    );

  const heroImage =
    getSetting("hero_image_url",
      getSetting("hero_image", "")
    );

  const heroTitle =
    getSetting(
      "hero_title",
      "Best Deals At Best Prices"
    );

  const heroDescription =
    getSetting(
      "hero_description",
      getSetting(
        "hero_subtitle",
        "Find the best deals and offers from top stores."
      )
    );

  const heroButtonText =
    getSetting(
      "hero_button_text",
      "Shop Now"
    );

  const heroButtonLink =
    getSetting(
      "hero_button_link",
      "/search"
    );

  const footerText =
    getSetting(
      "footer_text",
      "DealBaazi - Find the best deals online."
    );

  const footerEmail =
    getSetting(
      "footer_email",
      ""
    );

  const showCategories =
    String(
      getSetting("show_categories", "1")
    ) === "1";

  const showFeatured =
    String(
      getSetting("show_featured", "1")
    ) === "1";

  const showTrending =
    String(
      getSetting("show_trending", "1")
    ) === "1";

  const showHotDeals =
    String(
      getSetting("show_hot_deals", "1")
    ) === "1";
%>


<!-- =====================================================
     TOP BAR
===================================================== -->

<header class="topbar">

  <a href="/" class="brand">

    <img
      src="<%= logoValue %>"
      alt="DealBaazi"
      onerror="this.src='/images/logo.png'"
    >

    <div class="brand-text">
      Deal<span>Baazi</span>
    </div>

  </a>


  <div class="header-search">

    <form
      action="/search"
      method="GET"
      class="search-form"
    >

      <input
        type="text"
        name="q"
        placeholder="Search products, deals and offers..."
        value="<%= typeof query !== 'undefined' ? query : '' %>"
      >

      <button type="submit">
        🔍 Search
      </button>

    </form>

  </div>


  <div class="top-actions">

    <a
      href="/"
      class="top-btn home"
    >
      🏠 Home
    </a>

  </div>

</header>


<!-- =====================================================
     CATEGORY NAVIGATION
===================================================== -->

<% if (showCategories && categoryList.length > 0) { %>

  <nav class="category-bar">

    <div class="category-inner">

      <span class="category-title">
        Categories
      </span>

      <a
        href="/"
        class="category-link active"
      >
        All Deals
      </a>

      <% categoryList.forEach(category => { %>

        <a
          href="/category/<%= category.id %>"
          class="category-link"
        >
          <%= category.name %>
        </a>

      <% }) %>

    </div>

  </nav>

<% } %>


<!-- =====================================================
     MAIN CONTENT
===================================================== -->

<main class="main">


<% if (typeof searchResults !== "undefined") { %>

  <!-- ===================================================
       SEARCH RESULTS
  =================================================== -->

  <div class="result-heading">

    <h1>
      🔍 Search Results
    </h1>

    <p>
      Deals matching your search
    </p>

  </div>


  <section class="section">

    <div class="section-header">

      <h2>
        Search Results
      </h2>

      <span class="section-link">
        <%= searchResults.length %> Deals
      </span>

    </div>

    <div class="section-body">

      <% if (searchResults.length === 0) { %>

        <div class="empty">

          <div class="empty-icon">
            🔍
          </div>

          <strong>
            No products found
          </strong>

          <p style="margin-top:6px;">
            Try searching with another product name.
          </p>

        </div>

      <% } else { %>

        <div class="product-grid">

          <% searchResults.forEach(product => { %>

            <article class="product-card">

              <div class="product-image-wrap">

                <% if (discountValue(product)) { %>

                  <span class="deal-badge">
                    <%= discountValue(product) %>
                  </span>

                <% } %>

                <img
                  src="<%= product.image_url || '/images/logo.png' %>"
                  alt="<%= product.name %>"
                  class="product-image"
                  loading="lazy"
                  onerror="this.src='/images/logo.png'"
                >

              </div>


              <div class="product-content">

                <% if (product.category_name) { %>

                  <div class="product-category">
                    <%= product.category_name %>
                  </div>

                <% } %>

                <div class="product-name">
                  <%= product.name %>
                </div>

                <div class="rating">
                  ⭐ <%= product.rating || "0" %>/5
                </div>

                <div class="price-row">

                  <span class="sale-price">
                    ₹<%= Number(product.price || 0).toLocaleString("en-IN") %>
                  </span>

                  <% if (product.original_price) { %>

                    <span class="original-price">
