            <% }) %>

          </div>

        </section>

      <% } %>


      <!-- =========================
           ALL DEALS
           ========================= -->

      <% if (
        !siteSettings ||
        siteSettings.show_all_deals !== '0'
      ) { %>

        <section class="section">

          <div class="section-header">

            <h2 class="section-title">
              🛍️ <span>All Deals</span>
