  <!-- =====================================================
       SEARCH SCRIPT
  ===================================================== -->

  <script>

    const searchForm =
      document.getElementById("searchForm");

    const searchInput =
      document.getElementById("searchInput");


    if (searchForm && searchInput) {

      searchForm.addEventListener(
        "submit",
        function(event) {

          /*
            Existing server search route abhi
            implement nahi hai.

            Isliye homepage par client-side
            search use kar rahe hain.
          */

          const value =
            searchInput.value
              .trim()
              .toLowerCase();

          if (!value) {
            return;
          }

          event.preventDefault();

          const cards =
            document.querySelectorAll(
              ".searchable-product"
            );

          let found = 0;

          cards.forEach(card => {

            const name =
              card.dataset.name || "";

            const category =
              card.dataset.category || "";

            const match =
              name.includes(value) ||
              category.includes(value);

            if (match) {

              card.style.display = "";

              found++;

            } else {

              card.style.display = "none";

            }

          });


          const empty =
            document.getElementById(
              "searchEmptyHome"
            ) ||
            document.getElementById(
              "searchEmpty"
            );


          if (empty) {

            if (found === 0) {

              empty.style.display =
                "block";

            } else {

              empty.style.display =
                "none";

            }

          }


          const firstResult =
            document.querySelector(
              ".searchable-product:not([style*='display: none'])"
            );


          if (firstResult) {

            firstResult.scrollIntoView({
              behavior: "smooth",
              block: "center"
            });

          }

        }
      );


      searchInput.addEventListener(
        "input",
        function() {

          if (
            searchInput.value.trim() === ""
          ) {

            document
              .querySelectorAll(
                ".searchable-product"
              )
              .forEach(card => {

                card.style.display = "";

              });


            const empty =
              document.getElementById(
                "searchEmptyHome"
              ) ||
              document.getElementById(
                "searchEmpty"
              );


            if (empty) {

              empty.style.display =
                "none";

            }

          }

        }
      );

    }

  </script>


