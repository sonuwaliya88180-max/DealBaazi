                    >
                      Details
                    </a>

                    <a
                      href="/buy/<%= product.id %>"
                      class="buy-btn"
                    >
                      BUY NOW
                    </a>

                  </div>

                </div>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>


      <!-- =========================
           TOP RATED
           ========================= -->

      <% if (
