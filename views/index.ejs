            <h2 class="section-title">
              🔥 <span>Hot Deals</span>
            </h2>

          </div>


          <div class="products-grid">

            <% hotDeals.forEach(product => { %>

              <%
                const original = Number(product.original_price || 0);
                const selling = Number(product.price || 0);

                let discountPercent = 0;

                if (
                  original > 0 &&
                  selling > 0 &&
                  selling < original
                ) {
                  discountPercent = Math.round(
                    ((original - selling) / original) * 100
                  );
                }

                const savingAmount =
                  original > selling
                    ? original - selling
                    : 0;
              %>

              <article class="product-card">

                <div class="product-image-wrap">

                  <% if (discountPercent > 0) { %>

                    <div class="discount-badge">
                      <%= discountPercent %>% OFF
                    </div>

                  <% } %>

                  <img
                    class="product-image"
                    src="<%= product.image_url || '/images/placeholder.png' %>"
                    alt="<%= product.name %>"
                    loading="lazy"
                    onerror="this.src='/images/placeholder.png'"
                  >

                </div>


                <div class="product-info">

                  <div class="product-name">
                    <%= product.name %>
                  </div>

                  <div class="rating">
                    ⭐ <%= Number(product.rating || 0).toFixed(1) %>
                  </div>

                  <div class="price-row">

                    <span class="selling-price">
                      ₹<%= Number(selling).toLocaleString('en-IN') %>
                    </span>

                    <% if (original > selling) { %>

                      <span class="original-price">
                        ₹<%= Number(original).toLocaleString('en-IN') %>
                      </span>

                      <span class="discount-text">
                        <%= discountPercent %>% OFF
                      </span>

                    <% } %>

                  </div>

                  <% if (savingAmount > 0) { %>

                    <div class="saving">
                      You Save ₹<%= Number(savingAmount).toLocaleString('en-IN') %>
                    </div>

                  <% } %>

                  <div class="product-buttons">

                    <a
                      href="/product/<%= product.id %>"
                      class="details-btn"
                    >
                      Details
                    </a>

                    <a
                      href="/buy/<%= product.id %>"
                      class="buy-btn"
                    >
                      BUY NOW
                    </a>

                  </div>

                </div>

              </article>

            <% }) %>

          </div>

        </section>

      <% } %>


      <!-- =========================
