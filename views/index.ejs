       ========================= -->

  <footer>

    <div class="footer-inner">

      <div class="footer-logo">

        <img
          src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/images/logo.png' %>"
          alt="DealBaazi"
          onerror="this.src='/images/placeholder.png'"
        >

      </div>

      <div class="footer-text">

        <%= (typeof siteSettings !== 'undefined' && siteSettings.footer_text)
          ? siteSettings.footer_text
          : 'DealBaazi helps you discover amazing products, offers and discounts from online stores.' %>

      </div>

      <div class="copyright">

        © <%= new Date().getFullYear() %>
        DealBaazi. All Rights Reserved.

      </div>

