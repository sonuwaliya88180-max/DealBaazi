<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>DealBaazi Admin Login</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #ff6a00, #ee0979);
      padding: 20px;
    }

    .login-box {
      width: 100%;
      max-width: 400px;
      background: white;
      padding: 35px;
      border-radius: 18px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.25);
    }

    .logo {
      text-align: center;
      font-size: 32px;
      font-weight: bold;
      margin-bottom: 8px;
      color: #ff5a00;
    }

    .subtitle {
      text-align: center;
      color: #777;
      margin-bottom: 30px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-weight: bold;
      color: #333;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #ddd;
      border-radius: 10px;
      margin-bottom: 18px;
      font-size: 15px;
      outline: none;
    }

    input:focus {
      border-color: #ff5a00;
    }

    button {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 10px;
      background: #ff5a00;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #e64d00;
    }

    .error {
      background: #ffe5e5;
      color: #d00000;
      padding: 10px;
      border-radius: 8px;
      margin-bottom: 18px;
      text-align: center;
    }

    .footer {
      text-align: center;
      margin-top: 22px;
      color: #999;
      font-size: 13px;
    }
  </style>
</head>

<body>

  <div class="login-box">

    <div class="logo">🔥 DealBaazi</div>

    <div class="subtitle">
      Admin Panel Login
    </div>

    <% if (error) { %>
      <div class="error">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST">

      <label>Username</label>
      <input
        type="text"
        name="username"
        placeholder="Enter username"
        required
      >

      <label>Password</label>
      <input
        type="password"
        name="password"
        placeholder="Enter password"
        required
      >

      <button type="submit">
        🔐 Login
      </button>

    </form>

    <div class="footer">
      DealBaazi Admin System
    </div>

  </div>

</body>
</html>